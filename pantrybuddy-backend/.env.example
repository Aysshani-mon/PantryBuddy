# Copy this file to .env and fill in the real values your friend gave you.
# NEVER commit the real .env file — .gitignore already excludes it.

PORT=4000

DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=pantry_buddy
# Set to true if your host requires SSL (common for managed cloud MySQL
# like PlanetScale, AWS RDS, Azure, etc). If unsure, try true first.
DB_SSL=false

# Any long random string — e.g. generate with `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string

# Your Gmail address and App Password — used to send password-reset
# emails via your own Gmail account. NOT your normal Gmail password —
# see README "Email (Gmail SMTP)" for how to generate an App Password.
# Leave unset for local testing; the backend logs the reset link to the
# console instead of emailing it.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Your deployed Flutter app's URL — used to build the link inside
# password-reset emails, e.g. https://pantrybuddy-yourname.vercel.app
FRONTEND_URL=
